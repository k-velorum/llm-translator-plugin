{
  "manifest_version": 3,
  "name": "LLM翻訳プラグイン",
  "version": "1.1.0",
  "description": "選択したテキストやTwitterのツイートをLLMを使用して翻訳する拡張機能",
  "permissions": [
    "contextMenus",
    "storage",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://openrouter.ai/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.z.ai/*",
    "https://api.cerebras.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://localhost/*",
    "https://127.0.0.1/*",
    "https://youtube.com/*",
    "https://*.youtube.com/*",
    "https://*.twitter.com/*",
    "https://*.x.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
    "js": [
      "src/content/namespace.js",
      "src/content/messaging.js",
      "src/content/settings.js",
      "src/content/shared.js",
        "src/content/streaming.js",
        "src/content/selection.js",
        "src/content/page-translation.js",
        "src/content/twitter.js",
        "src/content/youtube.js",
        "src/content/runtime.js",
        "content.js"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http://*:* https://*:* https://openrouter.ai https://generativelanguage.googleapis.com https://api.z.ai https://api.cerebras.ai http://localhost:* http://127.0.0.1:* https://localhost:* https://127.0.0.1:*"
  },
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+T",
        "mac": "Command+Shift+T"
      },
      "description": "選択したテキストを翻訳"
    }
  }
}
